  "tokenColors": [
    {
      "name": "comment",
      "scope": [
        "comment",
        "punctuation.definition.comment",
        "string.quoted.docstring"
      ],
      "settings": {
        "foreground": "#8e7299",
        "fontStyle": "italic"
      }
    },
    {
      "name": "string",
      "scope": [
        "string",
        "punctuation.definition.string",
        "string.template",
        "markup.inline.raw"
      ],
      "settings": {
        "foreground": "#7f5e00"
      }
    },
    {
      "name": "escape",
      "scope": [
        "constant.character.escape",
        "string.regexp",
        "punctuation.definition.tag",
        "punctuation.definition.template-expression",
        "punctuation.section.embedded"
      ],
      "settings": {
        "foreground": "#4a56b8"
      }
    },
    {
      "name": "constant",
      "scope": [
        "constant",
        "constant.numeric",
        "constant.language",
        "constant.other",
        "support.constant",
        "variable.other.enummember",
        "keyword.other.unit",
        "constant.other.color"
      ],
      "settings": {
        "foreground": "#b83a28"
      }
    },
    {
      "name": "variable",
      "scope": [
        "variable",
        "variable.other",
        "variable.parameter",
        "entity.name.variable",
        "support.variable",
        "meta.object-literal.key",
        "variable.other.property",
        "variable.other.object.property"
      ],
      "settings": {
        "foreground": "#35203f"
      }
    },
    {
      "name": "keyword",
      "scope": [
        "keyword",
        "keyword.control",
        "storage",
        "storage.type",
        "storage.modifier",
        "variable.language",
        "keyword.operator.new",
        "keyword.operator.expression",
        "keyword.operator.logical.python",
        "markup.heading"
      ],
      "settings": {
        "foreground": "#be1f70"
      }
    },
    {
      "name": "operator",
      "scope": [
        "keyword.operator",
        "punctuation.separator.key-value",
        "punctuation.accessor.optional"
      ],
      "settings": {
        "foreground": "#a3306e"
      }
    },
    {
      "name": "type",
      "scope": [
        "entity.name.type",
        "entity.name.class",
        "entity.other.inherited-class",
        "support.class",
        "support.type",
        "entity.name.namespace",
        "entity.name.type.namespace",
        "storage.type.java",
        "storage.type.generic"
      ],
      "settings": {
        "foreground": "#4a56b8"
      }
    },
    {
      "name": "function",
      "scope": [
        "entity.name.function",
        "support.function",
        "variable.function",
        "meta.function-call.generic",
        "markup.underline.link",
        "string.other.link"
      ],
      "settings": {
        "foreground": "#a64f18"
      }
    },
    {
      "name": "attribute",
      "scope": [
        "entity.other.attribute-name",
        "meta.attribute"
      ],
      "settings": {
        "foreground": "#a9521c"
      }
    },
    {
      "name": "tag",
      "scope": [
        "entity.name.tag",
        "meta.preprocessor",
        "keyword.control.directive",
        "entity.name.function.preprocessor",
        "support.type.property-name",
        "entity.other.attribute-name.class.css",
        "entity.other.attribute-name.id.css",
        "entity.other.attribute-name.pseudo-class",
        "entity.other.attribute-name.pseudo-element"
      ],
      "settings": {
        "foreground": "#7a3d8c"
      }
    },
    {
      "name": "bold",
      "scope": [
        "markup.bold"
      ],
      "settings": {
        "fontStyle": "bold"
      }
    },
    {
      "name": "italic",
      "scope": [
        "markup.italic"
      ],
      "settings": {
        "fontStyle": "italic"
      }
    },
    {
      "name": "heading",
      "scope": [
        "markup.heading",
        "entity.name.section"
      ],
      "settings": {
        "fontStyle": "bold"
      }
    },
    {
      "name": "quote",
      "scope": [
        "markup.quote"
      ],
      "settings": {
        "foreground": "#8e7299",
        "fontStyle": "italic"
      }
    },
    {
      "name": "invalid",
      "scope": [
        "invalid",
        "invalid.illegal"
      ],
      "settings": {
        "foreground": "#c42b3a"
      }
    }
  ],
  "semanticTokenColors": {
    "namespace": "#4a56b8",
    "class": "#4a56b8",
    "interface": "#4a56b8",
    "enum": "#4a56b8",
    "struct": "#4a56b8",
    "type": "#4a56b8",
    "typeParameter": "#4a56b8",
    "function": "#a64f18",
    "method": "#a64f18",
    "macro": "#7a3d8c",
    "variable": "#35203f",
    "parameter": "#35203f",
    "property": "#35203f",
    "event": "#35203f",
    "enumMember": "#b83a28",
    "keyword": "#be1f70",
    "comment": "#8e7299",
    "string": "#7f5e00",
    "number": "#b83a28",
    "regexp": "#4a56b8",
    "operator": "#a3306e",
    "label": "#7a3d8c",
    "decorator": "#a9521c"
  }
}
