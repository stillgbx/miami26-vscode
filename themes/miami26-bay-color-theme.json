  "tokenColors": [
    {
      "name": "comment",
      "scope": [
        "comment",
        "punctuation.definition.comment",
        "string.quoted.docstring"
      ],
      "settings": {
        "foreground": "#64799c",
        "fontStyle": "italic"
      }
    },
    {
      "name": "string",
      "scope": [
        "string",
        "punctuation.definition.string",
        "string.template",
        "markup.inline.raw"
      ],
      "settings": {
        "foreground": "#f3ddb0"
      }
    },
    {
      "name": "escape",
      "scope": [
        "constant.character.escape",
        "string.regexp",
        "punctuation.definition.tag",
        "punctuation.definition.template-expression",
        "punctuation.section.embedded"
      ],
      "settings": {
        "foreground": "#f0a0c8"
      }
    },
    {
      "name": "constant",
      "scope": [
        "constant",
        "constant.numeric",
        "constant.language",
        "constant.other",
        "support.constant",
        "variable.other.enummember",
        "keyword.other.unit",
        "constant.other.color"
      ],
      "settings": {
        "foreground": "#f2a0b4"
      }
    },
    {
      "name": "variable",
      "scope": [
        "variable",
        "variable.other",
        "variable.parameter",
        "entity.name.variable",
        "support.variable",
        "meta.object-literal.key",
        "variable.other.property",
        "variable.other.object.property"
      ],
      "settings": {
        "foreground": "#e2eef2"
      }
    },
    {
      "name": "keyword",
      "scope": [
        "keyword",
        "keyword.control",
        "storage",
        "storage.type",
        "storage.modifier",
        "variable.language",
        "keyword.operator.new",
        "keyword.operator.expression",
        "keyword.operator.logical.python",
        "markup.heading"
      ],
      "settings": {
        "foreground": "#7fd8c8"
      }
    },
    {
      "name": "operator",
      "scope": [
        "keyword.operator",
        "punctuation.separator.key-value",
        "punctuation.accessor.optional"
      ],
      "settings": {
        "foreground": "#9fe3d6"
      }
    },
    {
      "name": "type",
      "scope": [
        "entity.name.type",
        "entity.name.class",
        "entity.other.inherited-class",
        "support.class",
        "support.type",
        "entity.name.namespace",
        "entity.name.type.namespace",
        "storage.type.java",
        "storage.type.generic"
      ],
      "settings": {
        "foreground": "#a9a6f0"
      }
    },
    {
      "name": "function",
      "scope": [
        "entity.name.function",
        "support.function",
        "variable.function",
        "meta.function-call.generic",
        "markup.underline.link",
        "string.other.link"
      ],
      "settings": {
        "foreground": "#8ec6ec"
      }
    },
    {
      "name": "attribute",
      "scope": [
        "entity.other.attribute-name",
        "meta.attribute"
      ],
      "settings": {
        "foreground": "#9ccbea"
      }
    },
    {
      "name": "tag",
      "scope": [
        "entity.name.tag",
        "meta.preprocessor",
        "keyword.control.directive",
        "entity.name.function.preprocessor",
        "support.type.property-name",
        "entity.other.attribute-name.class.css",
        "entity.other.attribute-name.id.css",
        "entity.other.attribute-name.pseudo-class",
        "entity.other.attribute-name.pseudo-element"
      ],
      "settings": {
        "foreground": "#f5b49c"
      }
    },
    {
      "name": "bold",
      "scope": [
        "markup.bold"
      ],
      "settings": {
        "fontStyle": "bold"
      }
    },
    {
      "name": "italic",
      "scope": [
        "markup.italic"
      ],
      "settings": {
        "fontStyle": "italic"
      }
    },
    {
      "name": "heading",
      "scope": [
        "markup.heading",
        "entity.name.section"
      ],
      "settings": {
        "fontStyle": "bold"
      }
    },
    {
      "name": "quote",
      "scope": [
        "markup.quote"
      ],
      "settings": {
        "foreground": "#64799c",
        "fontStyle": "italic"
      }
    },
    {
      "name": "invalid",
      "scope": [
        "invalid",
        "invalid.illegal"
      ],
      "settings": {
        "foreground": "#ff6b8b"
      }
    }
  ],
  "semanticTokenColors": {
    "namespace": "#a9a6f0",
    "class": "#a9a6f0",
    "interface": "#a9a6f0",
    "enum": "#a9a6f0",
    "struct": "#a9a6f0",
    "type": "#a9a6f0",
    "typeParameter": "#a9a6f0",
    "function": "#8ec6ec",
    "method": "#8ec6ec",
    "macro": "#f5b49c",
    "variable": "#e2eef2",
    "parameter": "#e2eef2",
    "property": "#e2eef2",
    "event": "#e2eef2",
    "enumMember": "#f2a0b4",
    "keyword": "#7fd8c8",
    "comment": "#64799c",
    "string": "#f3ddb0",
    "number": "#f2a0b4",
    "regexp": "#f0a0c8",
    "operator": "#9fe3d6",
    "label": "#f5b49c",
    "decorator": "#9ccbea"
  }
}
