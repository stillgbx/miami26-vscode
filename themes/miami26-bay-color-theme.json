  "tokenColors": [
    {
      "name": "comment",
      "scope": [
        "comment",
        "punctuation.definition.comment",
        "string.quoted.docstring"
      ],
      "settings": {
        "foreground": "#557489",
        "fontStyle": "italic"
      }
    },
    {
      "name": "string",
      "scope": [
        "string",
        "punctuation.definition.string",
        "string.template",
        "markup.inline.raw"
      ],
      "settings": {
        "foreground": "#ffc98f"
      }
    },
    {
      "name": "escape",
      "scope": [
        "constant.character.escape",
        "string.regexp",
        "punctuation.definition.tag",
        "punctuation.definition.template-expression",
        "punctuation.section.embedded"
      ],
      "settings": {
        "foreground": "#ff8fb8"
      }
    },
    {
      "name": "constant",
      "scope": [
        "constant",
        "constant.numeric",
        "constant.language",
        "constant.other",
        "support.constant",
        "variable.other.enummember",
        "keyword.other.unit",
        "constant.other.color"
      ],
      "settings": {
        "foreground": "#ff9cc2"
      }
    },
    {
      "name": "variable",
      "scope": [
        "variable",
        "variable.other",
        "variable.parameter",
        "entity.name.variable",
        "support.variable",
        "meta.object-literal.key",
        "variable.other.property",
        "variable.other.object.property"
      ],
      "settings": {
        "foreground": "#dcebf5"
      }
    },
    {
      "name": "keyword",
      "scope": [
        "keyword",
        "keyword.control",
        "storage",
        "storage.type",
        "storage.modifier",
        "variable.language",
        "keyword.operator.new",
        "keyword.operator.expression",
        "keyword.operator.logical.python",
        "markup.heading"
      ],
      "settings": {
        "foreground": "#2ed3c6"
      }
    },
    {
      "name": "operator",
      "scope": [
        "keyword.operator",
        "punctuation.separator.key-value",
        "punctuation.accessor.optional"
      ],
      "settings": {
        "foreground": "#8fe9e1"
      }
    },
    {
      "name": "type",
      "scope": [
        "entity.name.type",
        "entity.name.class",
        "entity.other.inherited-class",
        "support.class",
        "support.type",
        "entity.name.namespace",
        "entity.name.type.namespace",
        "storage.type.java",
        "storage.type.generic"
      ],
      "settings": {
        "foreground": "#b9a6ff"
      }
    },
    {
      "name": "function",
      "scope": [
        "entity.name.function",
        "support.function",
        "variable.function",
        "meta.function-call.generic",
        "markup.underline.link",
        "string.other.link"
      ],
      "settings": {
        "foreground": "#7cc4ff"
      }
    },
    {
      "name": "attribute",
      "scope": [
        "entity.other.attribute-name",
        "meta.attribute"
      ],
      "settings": {
        "foreground": "#8ccbff"
      }
    },
    {
      "name": "tag",
      "scope": [
        "entity.name.tag",
        "meta.preprocessor",
        "keyword.control.directive",
        "entity.name.function.preprocessor",
        "support.type.property-name",
        "entity.other.attribute-name.class.css",
        "entity.other.attribute-name.id.css",
        "entity.other.attribute-name.pseudo-class",
        "entity.other.attribute-name.pseudo-element"
      ],
      "settings": {
        "foreground": "#7edc9e"
      }
    },
    {
      "name": "bold",
      "scope": [
        "markup.bold"
      ],
      "settings": {
        "fontStyle": "bold"
      }
    },
    {
      "name": "italic",
      "scope": [
        "markup.italic"
      ],
      "settings": {
        "fontStyle": "italic"
      }
    },
    {
      "name": "heading",
      "scope": [
        "markup.heading",
        "entity.name.section"
      ],
      "settings": {
        "fontStyle": "bold"
      }
    },
    {
      "name": "quote",
      "scope": [
        "markup.quote"
      ],
      "settings": {
        "foreground": "#557489",
        "fontStyle": "italic"
      }
    },
    {
      "name": "invalid",
      "scope": [
        "invalid",
        "invalid.illegal"
      ],
      "settings": {
        "foreground": "#ff6b8b"
      }
    }
  ],
  "semanticTokenColors": {
    "namespace": "#b9a6ff",
    "class": "#b9a6ff",
    "interface": "#b9a6ff",
    "enum": "#b9a6ff",
    "struct": "#b9a6ff",
    "type": "#b9a6ff",
    "typeParameter": "#b9a6ff",
    "function": "#7cc4ff",
    "method": "#7cc4ff",
    "macro": "#7edc9e",
    "variable": "#dcebf5",
    "parameter": "#dcebf5",
    "property": "#dcebf5",
    "event": "#dcebf5",
    "enumMember": "#ff9cc2",
    "keyword": "#2ed3c6",
    "comment": "#557489",
    "string": "#ffc98f",
    "number": "#ff9cc2",
    "regexp": "#ff8fb8",
    "operator": "#8fe9e1",
    "label": "#7edc9e",
    "decorator": "#8ccbff"
  }
}
