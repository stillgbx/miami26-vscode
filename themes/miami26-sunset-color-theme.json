  "tokenColors": [
    {
      "name": "comment",
      "scope": [
        "comment",
        "punctuation.definition.comment",
        "string.quoted.docstring"
      ],
      "settings": {
        "foreground": "#8c72a8",
        "fontStyle": "italic"
      }
    },
    {
      "name": "string",
      "scope": [
        "string",
        "punctuation.definition.string",
        "string.template",
        "markup.inline.raw"
      ],
      "settings": {
        "foreground": "#f6e2a2"
      }
    },
    {
      "name": "escape",
      "scope": [
        "constant.character.escape",
        "string.regexp",
        "punctuation.definition.tag",
        "punctuation.definition.template-expression",
        "punctuation.section.embedded"
      ],
      "settings": {
        "foreground": "#9aa6ff"
      }
    },
    {
      "name": "constant",
      "scope": [
        "constant",
        "constant.numeric",
        "constant.language",
        "constant.other",
        "support.constant",
        "variable.other.enummember",
        "keyword.other.unit",
        "constant.other.color"
      ],
      "settings": {
        "foreground": "#ff8a7a"
      }
    },
    {
      "name": "variable",
      "scope": [
        "variable",
        "variable.other",
        "variable.parameter",
        "entity.name.variable",
        "support.variable",
        "meta.object-literal.key",
        "variable.other.property",
        "variable.other.object.property"
      ],
      "settings": {
        "foreground": "#f6e2ee"
      }
    },
    {
      "name": "keyword",
      "scope": [
        "keyword",
        "keyword.control",
        "storage",
        "storage.type",
        "storage.modifier",
        "variable.language",
        "keyword.operator.new",
        "keyword.operator.expression",
        "keyword.operator.logical.python",
        "markup.heading"
      ],
      "settings": {
        "foreground": "#ff5faa"
      }
    },
    {
      "name": "operator",
      "scope": [
        "keyword.operator",
        "punctuation.separator.key-value",
        "punctuation.accessor.optional"
      ],
      "settings": {
        "foreground": "#ff9cc8"
      }
    },
    {
      "name": "type",
      "scope": [
        "entity.name.type",
        "entity.name.class",
        "entity.other.inherited-class",
        "support.class",
        "support.type",
        "entity.name.namespace",
        "entity.name.type.namespace",
        "storage.type.java",
        "storage.type.generic"
      ],
      "settings": {
        "foreground": "#a9b4f5"
      }
    },
    {
      "name": "function",
      "scope": [
        "entity.name.function",
        "support.function",
        "variable.function",
        "meta.function-call.generic",
        "markup.underline.link",
        "string.other.link"
      ],
      "settings": {
        "foreground": "#ffb27a"
      }
    },
    {
      "name": "attribute",
      "scope": [
        "entity.other.attribute-name",
        "meta.attribute"
      ],
      "settings": {
        "foreground": "#ffbc8a"
      }
    },
    {
      "name": "tag",
      "scope": [
        "entity.name.tag",
        "meta.preprocessor",
        "keyword.control.directive",
        "entity.name.function.preprocessor",
        "support.type.property-name",
        "entity.other.attribute-name.class.css",
        "entity.other.attribute-name.id.css",
        "entity.other.attribute-name.pseudo-class",
        "entity.other.attribute-name.pseudo-element"
      ],
      "settings": {
        "foreground": "#d6a2f2"
      }
    },
    {
      "name": "bold",
      "scope": [
        "markup.bold"
      ],
      "settings": {
        "fontStyle": "bold"
      }
    },
    {
      "name": "italic",
      "scope": [
        "markup.italic"
      ],
      "settings": {
        "fontStyle": "italic"
      }
    },
    {
      "name": "heading",
      "scope": [
        "markup.heading",
        "entity.name.section"
      ],
      "settings": {
        "fontStyle": "bold"
      }
    },
    {
      "name": "quote",
      "scope": [
        "markup.quote"
      ],
      "settings": {
        "foreground": "#8c72a8",
        "fontStyle": "italic"
      }
    },
    {
      "name": "invalid",
      "scope": [
        "invalid",
        "invalid.illegal"
      ],
      "settings": {
        "foreground": "#ff5c6c"
      }
    }
  ],
  "semanticTokenColors": {
    "namespace": "#a9b4f5",
    "class": "#a9b4f5",
    "interface": "#a9b4f5",
    "enum": "#a9b4f5",
    "struct": "#a9b4f5",
    "type": "#a9b4f5",
    "typeParameter": "#a9b4f5",
    "function": "#ffb27a",
    "method": "#ffb27a",
    "macro": "#d6a2f2",
    "variable": "#f6e2ee",
    "parameter": "#f6e2ee",
    "property": "#f6e2ee",
    "event": "#f6e2ee",
    "enumMember": "#ff8a7a",
    "keyword": "#ff5faa",
    "comment": "#8c72a8",
    "string": "#f6e2a2",
    "number": "#ff8a7a",
    "regexp": "#9aa6ff",
    "operator": "#ff9cc8",
    "label": "#d6a2f2",
    "decorator": "#ffbc8a"
  }
}
