  "tokenColors": [
    {
      "name": "comment",
      "scope": [
        "comment",
        "punctuation.definition.comment",
        "string.quoted.docstring"
      ],
      "settings": {
        "foreground": "#7c6fa3",
        "fontStyle": "italic"
      }
    },
    {
      "name": "string",
      "scope": [
        "string",
        "punctuation.definition.string",
        "string.template",
        "markup.inline.raw"
      ],
      "settings": {
        "foreground": "#ffd27f"
      }
    },
    {
      "name": "escape",
      "scope": [
        "constant.character.escape",
        "string.regexp",
        "punctuation.definition.tag",
        "punctuation.definition.template-expression",
        "punctuation.section.embedded"
      ],
      "settings": {
        "foreground": "#8e9bff"
      }
    },
    {
      "name": "constant",
      "scope": [
        "constant",
        "constant.numeric",
        "constant.language",
        "constant.other",
        "support.constant",
        "variable.other.enummember",
        "keyword.other.unit",
        "constant.other.color"
      ],
      "settings": {
        "foreground": "#ff7a6b"
      }
    },
    {
      "name": "variable",
      "scope": [
        "variable",
        "variable.other",
        "variable.parameter",
        "entity.name.variable",
        "support.variable",
        "meta.object-literal.key",
        "variable.other.property",
        "variable.other.object.property"
      ],
      "settings": {
        "foreground": "#f3ddf0"
      }
    },
    {
      "name": "keyword",
      "scope": [
        "keyword",
        "keyword.control",
        "storage",
        "storage.type",
        "storage.modifier",
        "variable.language",
        "keyword.operator.new",
        "keyword.operator.expression",
        "keyword.operator.logical.python",
        "markup.heading"
      ],
      "settings": {
        "foreground": "#ff4fa3"
      }
    },
    {
      "name": "operator",
      "scope": [
        "keyword.operator",
        "punctuation.separator.key-value",
        "punctuation.accessor.optional"
      ],
      "settings": {
        "foreground": "#ff8fc4"
      }
    },
    {
      "name": "type",
      "scope": [
        "entity.name.type",
        "entity.name.class",
        "entity.other.inherited-class",
        "support.class",
        "support.type",
        "entity.name.namespace",
        "entity.name.type.namespace",
        "storage.type.java",
        "storage.type.generic"
      ],
      "settings": {
        "foreground": "#a9b4f5"
      }
    },
    {
      "name": "function",
      "scope": [
        "entity.name.function",
        "support.function",
        "variable.function",
        "meta.function-call.generic",
        "markup.underline.link",
        "string.other.link"
      ],
      "settings": {
        "foreground": "#ffa45c"
      }
    },
    {
      "name": "attribute",
      "scope": [
        "entity.other.attribute-name",
        "meta.attribute"
      ],
      "settings": {
        "foreground": "#ffb070"
      }
    },
    {
      "name": "tag",
      "scope": [
        "entity.name.tag",
        "meta.preprocessor",
        "keyword.control.directive",
        "entity.name.function.preprocessor",
        "support.type.property-name",
        "entity.other.attribute-name.class.css",
        "entity.other.attribute-name.id.css",
        "entity.other.attribute-name.pseudo-class",
        "entity.other.attribute-name.pseudo-element"
      ],
      "settings": {
        "foreground": "#d39bff"
      }
    },
    {
      "name": "bold",
      "scope": [
        "markup.bold"
      ],
      "settings": {
        "fontStyle": "bold"
      }
    },
    {
      "name": "italic",
      "scope": [
        "markup.italic"
      ],
      "settings": {
        "fontStyle": "italic"
      }
    },
    {
      "name": "heading",
      "scope": [
        "markup.heading",
        "entity.name.section"
      ],
      "settings": {
        "fontStyle": "bold"
      }
    },
    {
      "name": "quote",
      "scope": [
        "markup.quote"
      ],
      "settings": {
        "foreground": "#7c6fa3",
        "fontStyle": "italic"
      }
    },
    {
      "name": "invalid",
      "scope": [
        "invalid",
        "invalid.illegal"
      ],
      "settings": {
        "foreground": "#ff5c6c"
      }
    }
  ],
  "semanticTokenColors": {
    "namespace": "#a9b4f5",
    "class": "#a9b4f5",
    "interface": "#a9b4f5",
    "enum": "#a9b4f5",
    "struct": "#a9b4f5",
    "type": "#a9b4f5",
    "typeParameter": "#a9b4f5",
    "function": "#ffa45c",
    "method": "#ffa45c",
    "macro": "#d39bff",
    "variable": "#f3ddf0",
    "parameter": "#f3ddf0",
    "property": "#f3ddf0",
    "event": "#f3ddf0",
    "enumMember": "#ff7a6b",
    "keyword": "#ff4fa3",
    "comment": "#7c6fa3",
    "string": "#ffd27f",
    "number": "#ff7a6b",
    "regexp": "#8e9bff",
    "operator": "#ff8fc4",
    "label": "#d39bff",
    "decorator": "#ffb070"
  }
}
